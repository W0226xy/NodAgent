# ==================================================
# PostgreSQL
# ==================================================

POSTGRES_USER=nodagent
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nodagent

# Host development defaults.
# Docker Compose overrides these internally.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432


# ==================================================
# Redis / Celery
# ==================================================

REDIS_URL=redis://localhost:16379/0

CELERY_BROKER_URL=redis://localhost:16379/0

CELERY_RESULT_BACKEND=redis://localhost:16379/1


# ==================================================
# Chat LLM (OpenAI-compatible API)
# ==================================================

LLM_BASE_URL=https://your-llm-provider.example/v1

LLM_API_KEY=your_llm_api_key

LLM_MODEL=your_model_name

# Maximum completion length for an individual model call. Web summaries need
# enough room to finish without ending mid-sentence.
LLM_MAX_TOKENS=4096


# ==================================================
# Embedding (OpenAI-compatible API)
# ==================================================

EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1

EMBEDDING_API_KEY=your_embedding_api_key

EMBEDDING_MODEL=your_embedding_model_name

EMBEDDING_DIMENSION=your_embedding_dimension


# ==================================================
# LangGraph
# ==================================================

LANGGRAPH_STRICT_MSGPACK=true


# ==================================================
# GitHub MCP
# ==================================================

GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token

# Host development value.
# Docker Compose overrides backend to:
# http://github-mcp:8082

GITHUB_MCP_URL=http://127.0.0.1:8082

# Bounded waits for GitHub MCP initialization and tool calls. The Compose
# services override only the host name, never these limits.
GITHUB_MCP_TIMEOUT_SECONDS=20
GITHUB_MCP_INIT_TIMEOUT_SECONDS=10


# ==================================================
# Web Search MCP (Tavily)
# ==================================================

# Tavily Remote MCP base endpoint. The runtime adds the API key securely as
# the `tavilyApiKey` connection parameter required by Tavily's remote MCP.
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# Leave either value empty to disable web search gracefully.
TAVILY_API_KEY=
